# electron-vite@5.0.0 (latest stable) has not yet widened its peer range to include
# vite@8, but the locked stack pins vite@8.1.5. Both packages are legitimate and pinned;
# vite 8 works with electron-vite 5 at runtime (proven by `npm run build`). legacy-peer-deps
# keeps installs reproducible across Windows, Mac, and CI without changing any pinned version.
legacy-peer-deps=true
