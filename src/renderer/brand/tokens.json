{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "The NicoleBooks design tokens. Source of truth for brand and platform UI. W3C Design Tokens Community Group format. Structure and surface/type scales are inherited from the Magnet Group system, but the accent colors are taken from the NicoleBooks logo, so this file no longer matches themagnetgroup.xyz globals.css.",
  "$metadata": {
    "version": "2026.07.1",
    "owner": "The Magnet Group LLC",
    "notes": "2026-07-27: rebased brand colors onto the NicoleBooks logo (crimson stiletto over stacked pages). Logo palette is #910023 crimson, #0a0a0f near-black, #666 grey, #fff white. The former Magnet Group electric violet and lavender are retired here; see git history for their values."
  },

  "color": {
    "brand": {
      "primary":     { "$value": "#910023", "$type": "color", "$description": "Crimson, primary brand color, read straight off the NicoleBooks logo. 9.42:1 under white" },
      "primaryFg":   { "$value": "#ffffff", "$type": "color" },
      "accent":      { "$value": "#e28299", "$type": "color", "$description": "Rose, secondary brand color, a tint of the logo crimson. Lab L 65.3 and 4.68:1 under accentFg, holding the place the former lavender had in the scale" },
      "accentFg":    { "$value": "#343434", "$type": "color" }
    },
    "surface": {
      "$description": "Foreground = #343434, inherited from the Magnet Group system (it matches the dark color in the TMG logo; the TMG live site uses #1d1d1f and this guide normalizes on the logo). Carried over unchanged by the 2026-07-27 NicoleBooks rebrand, which only moved the accent colors.",
      "bg":          { "$value": "#ffffff", "$type": "color" },
      "fg":          { "$value": "#343434", "$type": "color" },
      "card":        { "$value": "#ffffff", "$type": "color" },
      "cardFg":      { "$value": "#343434", "$type": "color" },
      "popover":     { "$value": "#ffffff", "$type": "color" },
      "popoverFg":   { "$value": "#343434", "$type": "color" },
      "secondary":   { "$value": "#f5f5f7", "$type": "color" },
      "secondaryFg": { "$value": "#343434", "$type": "color" },
      "muted":       { "$value": "#f5f5f7", "$type": "color" },
      "mutedFg":     { "$value": "#6e6e73", "$type": "color" },
      "border":      { "$value": "#e5e5ea", "$type": "color" },
      "input":       { "$value": "#e5e5ea", "$type": "color" },
      "ring":        { "$value": "#910023", "$type": "color", "$description": "Brand crimson. 9.42:1 on the white background, well over the 3:1 WCAG 1.4.11 asks of a focus ring" }
    },
    "dark": {
      "$description": "Dark mode surface tokens. Apply when user or system preference is dark.",
      "bg":          { "$value": "#1a1a1a", "$type": "color" },
      "fg":          { "$value": "#f0f0f0", "$type": "color" },
      "card":        { "$value": "#242424", "$type": "color" },
      "cardFg":      { "$value": "#f0f0f0", "$type": "color" },
      "popover":     { "$value": "#2a2a2a", "$type": "color" },
      "popoverFg":   { "$value": "#f0f0f0", "$type": "color" },
      "secondary":   { "$value": "#2a2a2a", "$type": "color" },
      "secondaryFg": { "$value": "#e0e0e0", "$type": "color" },
      "muted":       { "$value": "#2a2a2a", "$type": "color" },
      "mutedFg":     { "$value": "#a0a0a0", "$type": "color" },
      "border":      { "$value": "#3a3a3a", "$type": "color" },
      "input":       { "$value": "#3a3a3a", "$type": "color" },
      "ring":        { "$value": "#e02a52", "$type": "color", "$description": "Lightened crimson for visibility on dark backgrounds. The brand crimson is only 1.85:1 on dark.bg; this holds 3.83:1 on bg, 3.42:1 on card and 3.16:1 on popover, at 6 degrees of hue drift so it still reads as the brand red" }
    },
    "semantic": {
      "destructive": { "$value": "#e8500f", "$type": "color", "$description": "Orange-red. Deliberately NOT the former #ff3b30, which sat only 11 degrees of hue from the crimson primary and so read as brand chrome rather than as an alert. This doubles the separation to 22.8 degrees while staying 24.9 degrees clear of warning" },
      "success":     { "$value": "#28a745", "$type": "color" },
      "warning":     { "$value": "#f59e0b", "$type": "color" },
      "info":        { "$value": "#910023", "$type": "color" }
    },
    "chart": {
      "1": { "$value": "#910023", "$type": "color" },
      "2": { "$value": "#e28299", "$type": "color" },
      "3": { "$value": "#343434", "$type": "color" },
      "4": { "$value": "#6e6e73", "$type": "color" },
      "5": { "$value": "#1d1d1f", "$type": "color" }
    }
  },

  "font": {
    "family": {
      "heading": { "$value": "Jost, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif", "$type": "fontFamily" },
      "sans":    { "$value": "'DM Sans', system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif", "$type": "fontFamily" },
      "mono":    { "$value": "ui-monospace, 'SF Mono', 'Cascadia Mono', Consolas, monospace", "$type": "fontFamily" }
    },
    "weight": {
      "regular":   { "$value": 400, "$type": "fontWeight" },
      "medium":    { "$value": 500, "$type": "fontWeight" },
      "semibold":  { "$value": 600, "$type": "fontWeight" },
      "bold":      { "$value": 700, "$type": "fontWeight" },
      "extrabold": { "$value": 800, "$type": "fontWeight" }
    },
    "size": {
      "xs":   { "$value": "0.75rem",  "$type": "dimension" },
      "sm":   { "$value": "0.875rem", "$type": "dimension" },
      "base": { "$value": "1rem",     "$type": "dimension" },
      "lg":   { "$value": "1.125rem", "$type": "dimension" },
      "xl":   { "$value": "1.25rem",  "$type": "dimension" },
      "2xl":  { "$value": "1.5rem",   "$type": "dimension" },
      "3xl":  { "$value": "1.875rem", "$type": "dimension" },
      "4xl":  { "$value": "2.25rem",  "$type": "dimension" },
      "5xl":  { "$value": "3rem",     "$type": "dimension" },
      "6xl":  { "$value": "3.75rem",  "$type": "dimension" },
      "7xl":  { "$value": "4.5rem",   "$type": "dimension" }
    },
    "lineHeight": {
      "tight":   { "$value": 1.2,  "$type": "number" },
      "snug":    { "$value": 1.35, "$type": "number" },
      "normal":  { "$value": 1.5,  "$type": "number" },
      "relaxed": { "$value": 1.75, "$type": "number" }
    },
    "tracking": {
      "tight":   { "$value": "-0.025em", "$type": "dimension" },
      "snug":    { "$value": "-0.015em", "$type": "dimension" },
      "normal":  { "$value": "0",        "$type": "dimension" },
      "wide":    { "$value": "0.025em",  "$type": "dimension" },
      "eyebrow": { "$value": "0.18em",   "$type": "dimension" }
    },
    "trackingBySize": {
      "$description": "Size-dependent tracking curve. Professional formula: -0.022em * fontSize above 32px. Use these instead of the flat tracking tokens for headings.",
      "7xl": { "$value": "-0.04em",  "$type": "dimension", "$description": "72px: tight tracking for maximum impact" },
      "6xl": { "$value": "-0.035em", "$type": "dimension", "$description": "60px" },
      "5xl": { "$value": "-0.03em",  "$type": "dimension", "$description": "48px" },
      "4xl": { "$value": "-0.025em", "$type": "dimension", "$description": "36px" },
      "3xl": { "$value": "-0.015em", "$type": "dimension", "$description": "30px: threshold where tightening begins" },
      "2xl": { "$value": "0",        "$type": "dimension", "$description": "24px and below: normal tracking" }
    }
  },

  "radius": {
    "base": { "$value": "0.5rem",    "$type": "dimension" },
    "sm":   { "$value": "0.375rem",  "$type": "dimension" },
    "md":   { "$value": "0.4375rem", "$type": "dimension" },
    "lg":   { "$value": "0.625rem",  "$type": "dimension" },
    "xl":   { "$value": "0.875rem",  "$type": "dimension" },
    "2xl":  { "$value": "1.125rem",  "$type": "dimension" },
    "3xl":  { "$value": "1.375rem",  "$type": "dimension" },
    "4xl":  { "$value": "1.625rem",  "$type": "dimension" },
    "pill": { "$value": "9999px",    "$type": "dimension" }
  },

  "radiusUsage": {
    "$description": "Which radius token to apply to which component type. Prevents blanket-radius.",
    "button":     { "$value": "{radius.pill}", "$type": "dimension", "$description": "Buttons always pill (9999px)" },
    "input":      { "$value": "{radius.md}",   "$type": "dimension", "$description": "Text inputs, selects, textareas" },
    "card":       { "$value": "{radius.xl}",   "$type": "dimension", "$description": "Cards, callouts, panels" },
    "modal":      { "$value": "{radius.2xl}",  "$type": "dimension", "$description": "Modals, sheets, dialogs" },
    "badge":      { "$value": "{radius.pill}", "$type": "dimension", "$description": "Status badges, pills, tags" },
    "structural": { "$value": "0",             "$type": "dimension", "$description": "Sidebars, headers, workspace panels: always zero radius" },
    "tooltip":    { "$value": "{radius.lg}",   "$type": "dimension", "$description": "Tooltips, popovers, dropdowns" }
  },

  "space": {
    "0":  { "$value": "0",       "$type": "dimension" },
    "1":  { "$value": "0.25rem", "$type": "dimension" },
    "2":  { "$value": "0.5rem",  "$type": "dimension" },
    "3":  { "$value": "0.75rem", "$type": "dimension" },
    "4":  { "$value": "1rem",    "$type": "dimension" },
    "5":  { "$value": "1.25rem", "$type": "dimension" },
    "6":  { "$value": "1.5rem",  "$type": "dimension" },
    "8":  { "$value": "2rem",    "$type": "dimension" },
    "10": { "$value": "2.5rem",  "$type": "dimension" },
    "12": { "$value": "3rem",    "$type": "dimension" },
    "16": { "$value": "4rem",    "$type": "dimension" },
    "20": { "$value": "5rem",    "$type": "dimension" },
    "24": { "$value": "6rem",    "$type": "dimension" },
    "32": { "$value": "8rem",    "$type": "dimension" }
  },

  "shadow": {
    "xs":    { "$value": "0 1px 2px rgba(15, 15, 20, 0.04)", "$type": "shadow" },
    "sm":    { "$value": "0 1px 3px rgba(15, 15, 20, 0.06), 0 1px 2px rgba(15, 15, 20, 0.04)", "$type": "shadow" },
    "md":    { "$value": "0 4px 12px rgba(15, 15, 20, 0.08)", "$type": "shadow" },
    "lg":    { "$value": "0 12px 32px rgba(15, 15, 20, 0.12)", "$type": "shadow" },
    "xl":    { "$value": "0 24px 56px rgba(15, 15, 20, 0.16)", "$type": "shadow" },
    "focus": { "$value": "0 0 0 3px rgba(145, 0, 35, 0.32)", "$type": "shadow" }
  },

  "motion": {
    "easing": {
      "standard":    { "$value": "cubic-bezier(0.2, 0, 0, 1)",  "$type": "cubicBezier" },
      "emphasized":  { "$value": "cubic-bezier(0.3, 0, 0, 1)",  "$type": "cubicBezier" },
      "out":         { "$value": "cubic-bezier(0, 0, 0.2, 1)",  "$type": "cubicBezier" },
      "in":          { "$value": "cubic-bezier(0.4, 0, 1, 1)",  "$type": "cubicBezier" }
    },
    "duration": {
      "instant": { "$value": "50ms",  "$type": "duration" },
      "fast":    { "$value": "150ms", "$type": "duration" },
      "medium":  { "$value": "250ms", "$type": "duration" },
      "slow":    { "$value": "400ms", "$type": "duration" }
    }
  },

  "container": {
    "sm":      { "$value": "640px",  "$type": "dimension" },
    "md":      { "$value": "768px",  "$type": "dimension" },
    "lg":      { "$value": "1024px", "$type": "dimension" },
    "xl":      { "$value": "1280px", "$type": "dimension" },
    "2xl":     { "$value": "1536px", "$type": "dimension" },
    "default": { "$value": "80rem",  "$type": "dimension", "$description": "max-w-7xl on the live site" }
  },

  "opacity": {
    "$description": "Named opacity values for interaction states and tinted surfaces. Prevents magic-number rgba everywhere.",
    "hover":     { "$value": 0.06, "$type": "number", "$description": "Tinted hover backgrounds: rgba(primary, hover)" },
    "container": { "$value": 0.12, "$type": "number", "$description": "Tinted containers, badge backgrounds, chip fills" },
    "pressed":   { "$value": 0.16, "$type": "number", "$description": "Active/pressed state tint" },
    "disabled":  { "$value": 0.38, "$type": "number", "$description": "Disabled element opacity" },
    "overlay":   { "$value": 0.5,  "$type": "number", "$description": "Modal backdrop, scrim" },
    "border":    { "$value": 0.08, "$type": "number", "$description": "Subtle tinted borders" }
  },

  "elevation": {
    "$description": "Z-index layering system. Use these tokens, never raw z-index numbers.",
    "base":    { "$value": 0,  "$type": "number", "$description": "Default content layer" },
    "raised":  { "$value": 10, "$type": "number", "$description": "Cards, FABs, floating elements" },
    "nav":     { "$value": 20, "$type": "number", "$description": "Navigation bars, sticky headers" },
    "overlay": { "$value": 30, "$type": "number", "$description": "Modals, sheets, drawers, backdrop" },
    "toast":   { "$value": 40, "$type": "number", "$description": "Toasts, snackbars, banners above modals" },
    "system":  { "$value": 50, "$type": "number", "$description": "System UI: dev tools, accessibility overlays" }
  },

  "interaction": {
    "$description": "Standard interaction state transforms. Prevents inconsistent press/hover behavior.",
    "pressScale": { "$value": "scale(0.98)",       "$type": "string", "$description": "Active/pressed state on buttons and tappable elements" },
    "hoverLift":  { "$value": "translateY(-2px)",  "$type": "string", "$description": "Hover lift on cards and clickable surfaces" },
    "pressDown":  { "$value": "translateY(1px)",   "$type": "string", "$description": "Micro-press feedback on small interactive elements" }
  },

  "layout": {
    "$description": "Responsive layout breakpoints for app development. Supplements web containers.",
    "phone":           { "$value": "428px",  "$type": "dimension", "$description": "Max phone width (iPhone 14 Pro Max logical)" },
    "tabletPortrait":  { "$value": "768px",  "$type": "dimension", "$description": "iPad portrait, switch to master-detail" },
    "tabletLandscape": { "$value": "1024px", "$type": "dimension", "$description": "iPad landscape, full multi-column" },
    "desktop":         { "$value": "1280px", "$type": "dimension", "$description": "Desktop, equivalent to container.xl" },
    "sidebarWidth":    { "$value": "280px",  "$type": "dimension", "$description": "Standard sidebar/drawer width on tablet+" },
    "navHeight":       { "$value": "56px",   "$type": "dimension", "$description": "Top navigation bar height (matches Material/HIG)" },
    "tabBarHeight":    { "$value": "49px",   "$type": "dimension", "$description": "iOS tab bar height" },
    "bottomNavHeight": { "$value": "80px",   "$type": "dimension", "$description": "Material bottom nav with label" }
  }
}
